# Aurora 2.0 - Configuracao earlyoom (vai pra /etc/default/earlyoom)
# -r 60: report a cada 60s
# -m 5: kill quando RAM disponivel < 5%
# -M 1048576 (1GB): kill quando RAM+swap < 1GB
# --avoid: protege Claude e infraestrutura
# --prefer: prioriza matar comilões primeiro
# --prefer: nativos + Flatpaks descartaveis (comm <=15 chars, case-sensitive).
# Discord (maiusculo) = Flatpak; discord (minusculo) = nativo possivel.
# Fora de --prefer (estado nao salvo): gimp, krita, obs, onlyoffice, obsidian, thunderbird.
EARLYOOM_ARGS="-r 60 -m 5 -M 1048576 --avoid '^(systemd|systemd-.*|Xorg|gnome-shell|mutter|cca|agente|node|tmux:.*|sshd|NetworkManager|python.*main\.py|python.*luna|venv_tts.*python|ollama|product-oom-watchdog)$' --prefer '^(chrome|chromium|firefox|slack|zoom|electron|discord|Discord|teams|code|agente|VSCodeHelper|msedge|waterfox|spotify|telegram-deskto|zapzap)$'"
