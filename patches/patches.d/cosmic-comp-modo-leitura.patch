+    /// o teste e explicito.
+    pub fn leitura_textura_clamp(&self) -> f32 {
+        if self.leitura_textura.is_nan() {
+            0.0
+        } else {
+            self.leitura_textura.clamp(0.0, 1.0)
+        }
     }
 }

