+    ///
+    /// A CONTA E AQUI, E NAO NO SHADER, porque ela e sempre a mesma: Kelvin ->
+    /// RGB custa log() e pow() por pixel, em tela cheia, todo quadro. Aqui sai
+    /// uma vez por mudanca de config.
+    ///
+    /// `[1.0, 1.0, 1.0]` (neutro) para 0 = desligado, e tambem para qualquer
+    /// valor fora da tabela: um numero absurdo digitado na chave apaga o efeito
+    /// em vez de pintar a tela de uma cor que ninguem pediu.
+    pub fn leitura_tint(&self) -> [f32; 3] {
+        let k = self.leitura_temperatura;
+        if k == 0 {
+            return [1.0, 1.0, 1.0];
+        }
+        let primeiro = LEITURA_WHITEPOINTS[0];
+        let ultimo = LEITURA_WHITEPOINTS[LEITURA_WHITEPOINTS.len() - 1];
+        if k <= primeiro.0 {
+            return primeiro.1;
+        }
+        if k >= ultimo.0 {
+            return ultimo.1;
+        }
+        for par in LEITURA_WHITEPOINTS.windows(2) {
+            let (lo_k, lo) = par[0];
+            let (hi_k, hi) = par[1];
+            if k >= lo_k && k <= hi_k {
+                let f = (k - lo_k) as f32 / (hi_k - lo_k) as f32;
+                return [
+                    lo[0] + (hi[0] - lo[0]) * f,
+                    lo[1] + (hi[1] - lo[1]) * f,
+                    lo[2] + (hi[2] - lo[2]) * f,
+                ];
+            }
+        }
+        [1.0, 1.0, 1.0]
+    }
