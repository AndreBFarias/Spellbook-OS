#!/bin/bash
# Hook commit-msg — Auto-fix de anonimato em mensagens de commit
# Estrategia: auto-remove violacoes → so bloqueia se mensagem ficar vazia
# Instalado via aplicar_hooks_globais()

source "$HOME/.config/git/hooks/_lib.sh" 2>/dev/null || true

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")
FIXES=0
BLOCKED=0

# [1/4] Auto-remove linhas Co-Authored-By / Paired-with / Assisted-by
COAUTHOR_PATTERN='^\s*(Co-Authored-By|co_authored|Paired-with|Assisted-by):.*$'
if echo "$MSG" | grep -qiE "$COAUTHOR_PATTERN"; then
    MSG=$(echo "$MSG" | grep -viE '^\s*(Co-Authored-By|co_authored|Paired-with|Assisted-by):')
    # Remover linhas em branco consecutivas no final
    MSG=$(echo "$MSG" | sed -e :a -e '/^\n*$/{$d;N;ba}')
    FIXES=$((FIXES + 1))
    _hook_log "commit-msg" "auto-remove: co-autoria" 2>/dev/null
fi

# [2/4] Auto-remove emojis
if echo "$MSG" | grep -qP "${EMOJI_RE:-[\x{1F600}-\x{1F64F}]}" 2>/dev/null; then
    MSG=$(echo "$MSG" | perl -CSD -pe "s/${EMOJI_RE:-[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}\x{1F900}-\x{1F9FF}\x{1FA00}-\x{1FA6F}\x{1FA70}-\x{1FAFF}]}//g" 2>/dev/null)
    FIXES=$((FIXES + 1))
    _hook_log "commit-msg" "auto-remove: emojis" 2>/dev/null
fi

# [3/4] Auto-substitui mencoes a IA no body (preserva subject line)
# [2026-07-28] Antes isto era `grep -viE`, que APAGAVA a linha inteira em vez
# de neutralizar a palavra. Como o padrao abaixo inclui "cursor", qualquer
# mensagem que citasse o cursor de CSS, de banco ou de texto perdia a frase
# toda, em silencio -- aconteceu no commit 0b2798b2 do protocolo-ouroboros.
# A substituicao preserva o conteudo e continua sem deixar rastro, alinhada
# com o bloco [3/6] do pre-commit, que ja substitui em vez de remover.
# [2026-07-30] A deteccao e a substituicao passaram para _ai_mention_in_text /
# _ai_mention_scrub_text (_lib.sh), que aplicam fronteira de palavra e o
# filtro de contexto do cursor. Antes disto, "corrige o path do <x>_ocr_cache"
# saia do hook nomeando um diretorio inexistente, e o mesmo texto no assunto
# era impossivel de commitar. Fallback abaixo: se _lib.sh não carregou, o hook
# NÃO pode falhar aberto -- define as funcoes com o comportamento minimo.
# A fronteira \< \> cobre o email de atribuicao pelo dominio do fornecedor.
_AI_FALLBACK_RE='\<(claude|anthropic|openai|chatgpt|copilot|gemini|gpt-[34]|deepseek|aider|windsurf|codeium|tabnine|opus|sonnet|haiku|fable)\>'
if ! declare -F _ai_mention_in_text >/dev/null 2>&1; then
    _ai_mention_in_text() {
        printf '%s\n' "$1" | grep -qiE "$_AI_FALLBACK_RE" 2>/dev/null
    }
    # No fallback o assunto ja e estrito (nada e preservado), entao a variante
    # do assunto e a mesma funcao -- mas precisa EXISTIR, senao o gate [4/4]
    # chama funcao inexistente e o hook falha aberto.
    _ai_mention_in_subject() {
        _ai_mention_in_text "$1"
    }
    _ai_mention_scrub_text() {
        # Mesma guarda do _lib.sh: nao reescrever identificador tecnico. E \< \>
        # vira \b porque o perl nao entende a fronteira do GNU -- deixar passar
        # desligaria o gate em silencio.
        local re="${_AI_FALLBACK_RE//\\</\\b}"; re="${re//\\>/\\b}"
        printf '%s\n' "$1" | perl -CSD -pe "s{(\`[^\`\n]*\`|\S*/\S*|[A-Za-z0-9]+(?:[-._][A-Za-z0-9]+)+)|$re}{ defined \$1 ? \$1 : q(agente) }gei"
    }
fi

SUBJECT=$(echo "$MSG" | head -1)
BODY=$(echo "$MSG" | tail -n +2)

if _ai_mention_in_text "$BODY"; then
    BODY=$(_ai_mention_scrub_text "$BODY")
    MSG="${SUBJECT}"
    if [[ -n "$BODY" ]]; then
        MSG="${SUBJECT}
${BODY}"
    fi
    # Remover linhas em branco consecutivas no final
    MSG=$(echo "$MSG" | sed -e :a -e '/^\n*$/{$d;N;ba}')
    FIXES=$((FIXES + 1))
    _hook_log "commit-msg" "auto-fix: mencao IA no body (substituicao)" 2>/dev/null
fi

# [4/4] Verificar se subject menciona IA (BLOQUEIA -- subject e intencional)
# _ai_mention_in_subject e nao _ai_mention_in_text: no assunto o hifen nao
# protege o token, senao o nome de qualquer ferramenta escrito em kebab passa
# pelo gate (ver _AI_KEEP_TOKEN_ASSUNTO em _lib.sh).
if _ai_mention_in_subject "$SUBJECT"; then
    echo "  [BLOQUEIO] Subject da mensagem menciona ferramenta de IA"
    echo "    Remova qualquer referencia a IA do subject"
    BLOCKED=1
    _hook_log "commit-msg" "BLOQUEIO: mencao IA no subject" 2>/dev/null
fi

# Gravar mensagem limpa de volta
echo "$MSG" > "$MSG_FILE"

# Warning de formato (nao bloqueia)
#
# HOOK-COMMITMSG-SEGAPE-FORMAT-01 (2026-08-07): em SEGAPE/pipelines o padrao do
# time e "<substantivo-de-acao> <objeto>" em PT-BR minusculo, sem ponto final
# ("ajuste regra valor obra", "inclusao coluna ano na tabela painel_escola"), e
# NAO conventional commits: dos 4.996 commits nao-merge do repo, so 4% usam
# "tipo: descricao" (medicao de 2026-08-07). Emitir o aviso ali empurrava para
# fora do padrao da equipe a cada commit.
#
# So o pipelines. Os demais repos sob Projetos_segape sao pessoais e usam
# conventional commits em 81% a 100% dos commits -- neles o aviso e util e fica
# ligado. Um except em Projetos_segape inteiro desligaria o aviso onde ele acerta.
_repo_root_fmt=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
case "$_repo_root_fmt" in
    */Projetos_segape/pipelines) _fmt_warn_off=1 ;;
    *)                           _fmt_warn_off=0 ;;
esac

if [ "$_fmt_warn_off" -eq 0 ] && ! echo "$SUBJECT" | grep -qE '^(feat|fix|refactor|docs|test|perf|chore|style|ci|build|release|micro):' 2>/dev/null; then
    echo "  [aviso] Formato recomendado: tipo: descricao (feat, fix, refactor, docs, test, perf, chore, style, ci, build, release)"
fi

# Relatorio
if [ $FIXES -gt 0 ]; then
    echo "  [commit-msg] $FIXES auto-fix(es) aplicado(s) na mensagem"
fi

# Verificar se mensagem ficou vazia apos limpeza
CLEAN_MSG=$(echo "$MSG" | sed '/^#/d' | sed '/^$/d' | tr -d '[:space:]')
if [[ -z "$CLEAN_MSG" ]]; then
    echo "  [BLOQUEIO] Mensagem ficou vazia apos limpeza de anonimato"
    BLOCKED=1
fi

if [ $BLOCKED -gt 0 ]; then
    _hook_log "commit-msg" "BLOQUEADO" 2>/dev/null
    exit 1
fi

# HOOK-POSTCOMMIT-CHAIN-01 (Leva 4.1 Luna, 2026-06-12, autorizado pelo dono):
# delega ao framework do repo Luna (gates M03 fechamento + M04 colateral +
# commit-msg-format) DEPOIS dos auto-fixes globais -- valida a mensagem ja
# limpa. Outros repos: zero impacto.
_luna_root_wiring="/home/andrefarias/Desenvolvimento/Luna"
_repo_root_msgwiring=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [ "$_repo_root_msgwiring" = "$_luna_root_wiring" ] && [ -x "$_luna_root_wiring/.git/hooks/commit-msg" ]; then
    bash "$_luna_root_wiring/.git/hooks/commit-msg" "$MSG_FILE" || exit $?
fi

_hook_log "commit-msg" "OK (fixes=$FIXES)" 2>/dev/null
exit 0

# "Errare humanum est, perseverare autem diabolicum." — Seneca
