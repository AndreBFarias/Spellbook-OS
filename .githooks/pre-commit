#!/bin/bash
# Hook Universal Pre-Commit - Auto-fix com relatorio
# Camada 1 de defesa: auto-fix em arquivos staged
# Instalado via aplicar_hooks_globais()

# INFRA-HOOK-LOCAL-WIRING-01 (sprint 199, 2026-05-22): delega para hook
# local do Nyx-Code quando o commit esta dentro daquele repo. Fecha
# defense-in-depth do invariante #14 (anti-sanitizer guard, sprint 196).
# Outros projetos do usuario passam direto (zero impacto).
_nyx_root="/home/andrefarias/Desenvolvimento/Nyx-Code"
_repo_root_wiring=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [ "$_repo_root_wiring" = "$_nyx_root" ]; then
    _local_hook="$_nyx_root/scripts/hooks/pre-commit"
    if [ -x "$_local_hook" ]; then
        "$_local_hook" || exit $?
    fi
fi

# AUDIT-PRECOMMIT-INERTE-REATIVAR (sprint do protocolo-ouroboros, 2026-06-11,
# autorizado pelo dono): delega para o framework pre-commit do repo quando o
# commit acontece dentro dele. Mesmo formato do wiring do Nyx-Code acima.
# Outros projetos passam direto (zero impacto). Backup do hook anterior em
# pre-commit.bak-AUDIT-PRECOMMIT-20260611.
_ouro_root="/home/andrefarias/Desenvolvimento/protocolo-ouroboros"
if [ "$_repo_root_wiring" = "$_ouro_root" ]; then
    if [ -f "$_ouro_root/hooks/run_framework.sh" ]; then
        bash "$_ouro_root/hooks/run_framework.sh" || exit $?
    fi
fi

source "$HOME/.config/git/hooks/_lib.sh" 2>/dev/null || true

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
cd "$REPO_ROOT" || exit 0

# [0] Validacao de identidade por contexto (SEMPRE roda)
# Graceful degradation: se _lib.sh nao carregou, usar logica inline
if type _hook_detect_context &>/dev/null; then
    _hook_detect_context "$REPO_ROOT"

# ---------------------------------------------------------------------------
# GUARDA DE CREDENCIAL -- bloqueia, nao sanitiza.
#
# Instalado em 31/07/2026. O hook tinha sanitizador de emoji e de mencao a IA,
# mas nada que barrasse credencial: uma auditoria mediu que, dos 23 arquivos de
# credencial reais deste usuario, o hook deixava passar 22. E a lista de
# extensoes que ele PULAVA incluia .key, .pem e .env -- exatamente as que quase
# sempre SAO credencial.
#
# Aqui nao ha auto-fix, de proposito. Segredo commitado nao se conserta
# reescrevendo o arquivo: o blob ja entrou no object database e sobrevive ao
# `git rm`. Foi assim que 18 credenciais deste vault ficaram recuperaveis por
# quatro meses. A unica resposta correta e recusar o commit.
# ---------------------------------------------------------------------------
_cred_bloqueados=""
for _f in $(git diff --cached --name-only --diff-filter=ACM 2>/dev/null); do
    [ -f "$_f" ] || continue

    # 1) o caminho: pasta de credencial, ou extensao que quase sempre e chave
    case "$_f" in
        # EXCECAO: o .zshrc da RAIZ deste repo e versionado POR DESIGN — e o
        # ponto de entrada do Spellbook-OS e esta no git desde 2026-05. O padrao
        # `.zshrc*` mais abaixo existe para barrar .zshrc de OUTRA origem (o home
        # de outra maquina, um backup com secret inline), mas casava tambem este,
        # e desde 31/07/2026 tornou o arquivo IMPOSSIVEL de commitar. Nao e
        # afrouxamento: o `continue` e que seria pulado, e este ramo cai direto
        # nas verificacoes de CONTEUDO abaixo, que seguem valendo para ele.
        .zshrc)
            ;;
        *Segredos/*|*Credenciais/*|*.key|*.pem|*.p12|*.pfx|*.jks|\
        *.git-credentials|*.zsh_secrets|*id_rsa*|*id_ed25519*|\
        *credentials.json|*service-account*.json|*senhas.yml|*senhas.yaml|\
        *recovery-codes*|*backup-codes*|*Backup-codes*|\
        *token*.txt|*tokens_*|*api?key*|*api-key*|*apikey*|*_api.txt|\
        *acessos-*|*acessos_*|.GA_*|*ambiente.json|*-ambiente.json|\
        *api.txt|*-api-*|.zshrc*|*zshrc-*|keys|chaves)
            _cred_bloqueados="$_cred_bloqueados
  $_f (pelo caminho)"
            continue ;;
    esac

    # 2) o conteudo: exige o CORPO da chave, nao a palavra. Sem isso,
    #    `paramiko.RSAKey.from_private_key(` viraria falso positivo -- foi
    #    exatamente o que aconteceu com o detector da Fase 1 antes de ser
    #    apertado.
    if grep -qP -- '-----BEGIN [A-Z ]*PRIVATE KEY-----[\r\n]+[A-Za-z0-9+/=]{40}' "$_f" 2>/dev/null \
    || grep -qP -- '"private_key"[[:space:]]*:[[:space:]]*"-----BEGIN' "$_f" 2>/dev/null \
    || grep -qP -- 'gh[pousr]_[A-Za-z0-9]{30}|github_pat_[A-Za-z0-9_]{30}' "$_f" 2>/dev/null \
    || grep -qP -- 'AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{15}|AIza[0-9A-Za-z_-]{30}' "$_f" 2>/dev/null \
    || grep -qP -- 'https?://[^/[:space:]:@]+:[^/[:space:]@]{6,}@' "$_f" 2>/dev/null \
    || grep -qP -- '(?i)^[[:space:]]*(export[[:space:]]+)?[A-Z_]*(TOKEN|SECRET|API_?KEY|PASSW|SENHA)[A-Z_]*=[^[:space:]$"'"'"']{8,}' "$_f" 2>/dev/null \
    || grep -qP -- '(?i)^[[:space:]]*[-*]?[[:space:]]*(senha|password|passwd|pwd)[[:space:]]*:[[:space:]]*\S{6,}' "$_f" 2>/dev/null \
    || grep -qcP -- '^[[:space:]]*[a-z0-9]{5}-[a-z0-9]{5}[[:space:]]*$' "$_f" 2>/dev/null | grep -qE '^[3-9]|^[0-9]{2,}' ; then
        _cred_bloqueados="$_cred_bloqueados
  $_f (pelo conteudo)"
    fi
done

if [ -n "$_cred_bloqueados" ]; then
    printf '\n\033[0;31m  COMMIT BLOQUEADO: credencial detectada\033[0m\n'
    printf '%s\n' "$_cred_bloqueados"
    printf '\n  Segredo nao mora em repositorio. O cofre e ~/Cofre/segredos.kdbx:\n'
    printf '    python3 ~/"Controle de Bordo"/.sistema/scripts/segredos.py inventario\n'
    printf '\n  Se for mesmo falso positivo -- exemplo em documentacao, chave de\n'
    printf '  teste, fixture -- o git tem uma flag para pular os hooks. Prefira\n'
    printf '  ajustar o arquivo a usa-la: o proximo commit encontra o mesmo bloqueio.\n\n'
    exit 1
fi

    _hook_validate_identity || exit 1
else
    CURRENT_NAME=$(git config --get user.name)
    CURRENT_EMAIL=$(git config --get user.email)

    # Fallback: resolver identidade via variaveis de config.local.zsh
    EXPECTED_NAME=""
    CONTEXT="Pessoal"
    for tag in $ZSH_IDENTITY_TAGS; do
        local path_var="ZSH_IDENTITY_${tag}_PATH"
        local path_pattern="${!path_var}"
        if [[ -n "$path_pattern" && ("$REPO_ROOT" == *"/${path_pattern}/"* || "$REPO_ROOT" == *"/${path_pattern}") ]]; then
            local name_var="ZSH_IDENTITY_${tag}_NAME"
            local email_var="ZSH_IDENTITY_${tag}_EMAIL"
            EXPECTED_NAME="${!name_var}"
            EXPECTED_EMAIL="${!email_var}"
            CONTEXT="$tag"
            break
        fi
    done
    if [[ -z "$EXPECTED_NAME" ]]; then
        EXPECTED_NAME="${ZSH_GIT_NAME_PESSOAL:-$(git config --global user.name)}"
        EXPECTED_EMAIL="${ZSH_GIT_EMAIL_PESSOAL:-$(git config --global user.email)}"
    fi

    if [[ "$CURRENT_NAME" != "$EXPECTED_NAME" || "$CURRENT_EMAIL" != "$EXPECTED_EMAIL" ]]; then
        echo "  [BLOQUEIO] Identidade incorreta para contexto $CONTEXT"
        echo "    Esperado: $EXPECTED_NAME <$EXPECTED_EMAIL>"
        echo "    Atual:    $CURRENT_NAME <$CURRENT_EMAIL>"
        echo "    Corrija com: santuario <projeto>"
        exit 1
    fi
fi

# Detectar se projeto usa framework pre-commit
HAS_FRAMEWORK=false
[ -f ".pre-commit-config.yaml" ] && HAS_FRAMEWORK=true

STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$STAGED" ] && exit 0

# Filtrar binarios, venv, lock files, etc.
filter_files() {
    local result=""
    for file in $1; do
        # BYTE-EXATO (2026-07-29, autorizado pelo dono): arquivos cujo md5 e o
        # contrato -- artefatos de firmware, blobs de vendor, fixtures binarias.
        # O auto-fix de whitespace (sed 's/[[:space:]]*$//') e o append de newline
        # final MUDAM os bytes e quebram md5 versionado / gate de instalador.
        # Mecanismo opt-in e geral: o repo declara no .gitattributes versionado
        #     caminho/arquivo   byte-exact
        # e nenhum repo sem esse atributo muda de comportamento.
        if git check-attr byte-exact -- "$file" 2>/dev/null | grep -q ': set$'; then
            continue
        fi
        case "$file" in
            venv/*|.venv/*|node_modules/*|__pycache__/*) continue ;;
            .git/*|.mypy_cache/*|.pytest_cache/*|.ruff_cache/*) continue ;;
            hooks/*|.githooks/*|.git/hooks/*) continue ;;
            docs/claude/hooks/*|scripts/auditoria-repos.sh|scripts/universal-sanitizer.py) continue ;;
            scripts/ai_identifier_warn.py) continue ;;
            # CCI-CLAUDE-AI-FEATURE-EXCEPTION (2026-07-23, autorizado pelo dono): a
            # extension Ctrl+C Ilimitado tem uma funcionalidade real de exportar
            # conversas do site claude.ai. "claude.ai" (hostname real) e
            # "font-claude-message" (nome de classe CSS que o proprio site usa no
            # HTML dele) sao constantes externas, nao mencao/atribuicao a IA -- a
            # substituicao automatica pra "agente" quebra a deteccao de site e o
            # scraping do DOM. Mesmo escopo do wiring PFL7560 acima.
            aurora/userscripts/control-c-ilimitado-ext/*) continue ;;
            # MANTIS-SKILLS-PATH-EXCEPTION (2026-07-30, autorizado pelo dono): a
            # funcao mantis() (campanha google/mantis) referencia o diretorio real
            # ~/.claude/skills e o comando de instalacao `--agent claude-code`.
            # Sao path de filesystem e nome de agente -- constantes externas, nao
            # mencao/atribuicao a IA. A substituicao automatica pra "agente" gerava
            # ~/.agente/skills e --agent agente-code, quebrando a checagem e o
            # comando de reinstalacao. Mesmo escopo do CCI acima.
            # NOTA: filter_files() alimenta TODOS os blocos ([1/6]..[6/6]), entao
            # este arquivo fica fora tambem da varredura de emoji/acentuacao.
            cca/aliases_cca.zsh) continue ;;
            # SPECS-TECNICOS-EXCEPTION (2026-08-10, autorizado pelo dono): specs
            # de design em docs/superpowers/ descrevem ferramentas de terceiros
            # e precisam citar nomes de produto, arquivos de instrucao e linhas
            # de comando literais. O KEEP_TOKEN so preserva token com barra, e
            # mencao solta virava "agente Code" / "agente.md", mutilando prosa
            # tecnica e comando copiavel. Sao constantes externas, nao
            # atribuicao de autoria a IA. Mesmo escopo do CCI e do MANTIS acima.
            # CUSTO ACEITO: como filter_files() alimenta TODOS os blocos
            # ([1/6]..[6/6]), estes arquivos ficam fora tambem da varredura de
            # emoji/acentuacao -- rodar scripts/validar-acentuacao.py --paths a
            # mao ao escrever spec novo.
            docs/superpowers/*) continue ;;
            # HALLMARK-VENDOR-EXCEPTION (2026-08-10, autorizado pelo dono): copia
            # vendorizada de nutlope/hallmark, pinada por SHA em PROVENANCE.md.
            # Conteudo de terceiro precisa ser byte-identico ao upstream, senao
            # o pin mente e comparar com versao nova fica impossivel. O hook
            # mutilaria 3 mencoes soltas e removeria 41 emoji do texto original.
            # Nao e codigo nosso nem atribuicao de autoria -- e dependencia
            # copiada. Mesmo escopo do control-c-ilimitado-ext acima.
            docs/claude/skills/hallmark/*) continue ;;
            dist/*|build/*|.next/*|.nuxt/*|.eggs/*) continue ;;
            *.png|*.jpg|*.jpeg|*.gif|*.svg|*.ico|*.bmp|*.webp) continue ;;
            *.mp4|*.mp3|*.wav|*.flac|*.ogg|*.webm) continue ;;
            *.zip|*.tar|*.gz|*.bz2|*.xz|*.7z|*.rar) continue ;;
            *.woff|*.woff2|*.ttf|*.eot|*.otf) continue ;;
            *.pdf|*.doc|*.docx|*.xls|*.xlsx) continue ;;
            *.pyc|*.pyo|*.so|*.dylib|*.dll|*.class) continue ;;
            *.pt|*.onnx|*.safetensors|*.gguf) continue ;;
            *.lock|package-lock.json|yarn.lock|poetry.lock|Pipfile.lock) continue ;;
            *.min.js|*.min.css|*.map) continue ;;
            my-mailmap|.mailmap|.env|.env.*) continue ;;
            *)
                # PFL7560-FIX-EXCEPTION (2026-07-06, autorizado pelo dono):
                # nao aplicar auto-fix (whitespace/sanitizer) em arquivos de
                # config binarios/legacy nao-UTF-8 (ex.: ZYCustom.ini da
                # HiSilicon usa ASCII-estendido/NEL 0x85; o auto-fix cortava
                # ~2.5KB e corrompia o arquivo). Escopo: repo pfl7560, no
                # mesmo estilo dos wirings Nyx-Code/ouroboros/Luna acima.
                if [ "$REPO_ROOT" = "/home/andrefarias/Desktop/pfl7560" ] && [ -f "$file" ]; then
                    # (a) config legacy nao-UTF-8 (ex.: ZYCustom.ini HiSilicon, NEL 0x85)
                    if ! iconv -f UTF-8 -t UTF-8 "$file" >/dev/null 2>&1; then
                        continue
                    fi
                    # (b) artefatos byte-exatos com md5 travado por 'make check': o
                    # whitespace/NBSP e significativo (build.prop.STOCK tem NBSP+espaco na
                    # linha 62; o 'sed s/[[:space:]]*$//' cortava e quebrava o md5 fd8406c4
                    # do backup anti-envenenamento do pfl7560-fix.sh). Idem newline final
                    # em init.bigfish.rc.MOD (byte-exato do device).
                    case "$file" in
                        */artefatos/*.STOCK|*/artefatos/*.MOD|*/artefatos/*.ORIGINAL) continue ;;
                        */artefatos/ZYCustom*|*/artefatos/build.prop*|*/artefatos/perfis/*) continue ;;
                        pendrive-autorun/ZYCustom.ini) continue ;;
                    esac
                fi
                result="$result $file" ;;
        esac
    done
    echo "$result" | xargs 2>/dev/null
}

FILES=$(filter_files "$STAGED")
[ -z "$FILES" ] && exit 0

FIXES=0
BLOCKS=0
FIX_DETAILS=""

# OURO-HOOK-DUPLA-MUTACAO-EXCEPTION (2026-07-30, autorizado pelo dono): no
# protocolo-ouroboros os blocos abaixo param aqui. O repo JA rodou o framework
# proprio na delegacao do topo deste arquivo -- sao 18 hooks, e entre eles
# emoji, mencao a IA, acentuacao PT-BR, CPF/CNPJ do casal, paths obsoletos,
# print() e except vazio. Continuar daqui e rodar a MESMA verificacao duas
# vezes, com a diferenca de que a segunda MUTA o arquivo por fora do diff.
#
# O custo dessa duplicacao foi medido em 2026-07-30, num unico dia de trabalho:
#   - 15712a12: o mutador escalonado trocou um nome de fornecedor DENTRO de uma
#     string e a constante ficou apontando para um diretorio inexistente.
#     Nenhuma linha vermelha; descoberto por acaso. Restaurado em bfac3d78 --
#     cuja propria mensagem saiu do hook nomeando o diretorio errado.
#   - 295e1f18: reescreveu a palavra-isca de um teste DE REGRESSAO do proprio
#     corretor, dentro do commit da sprint que o consertava. O teste passou a
#     afirmar o contrario do que existe para provar, e ficou verde.
#   - 2026-07-27: 13 linhas de CSS corrompidas pelo mesmo caminho.
#
# A validacao de identidade [0] acima continua rodando para todos os repos,
# inclusive este -- e o unico check global que o framework do repo nao cobre.
#
# Reverter: cp pre-commit.bak-2026-07-30-ouroboros pre-commit
if [ "$_repo_root_wiring" = "$_ouro_root" ]; then
    exit 0
fi

# === VERIFICACOES DE ANONIMATO (rodam SEMPRE, mesmo com framework) ===

# [1/6] Anti-emoji (auto-fix + re-stage)
_EMOJI="${EMOJI_RE:-[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}\x{1F900}-\x{1F9FF}\x{1FA00}-\x{1FA6F}\x{1FA70}-\x{1FAFF}]}"
EMOJI_COUNT=0
for file in $FILES; do
    if [ -f "$file" ] && grep -qP "$_EMOJI" "$file" 2>/dev/null; then
        perl -i -CSD -pe "s/$_EMOJI//g" "$file" 2>/dev/null
        git add "$file" 2>/dev/null
        EMOJI_COUNT=$((EMOJI_COUNT + 1))
    fi
done
[ $EMOJI_COUNT -gt 0 ] && { FIXES=$((FIXES + EMOJI_COUNT)); FIX_DETAILS="$FIX_DETAILS emojis($EMOJI_COUNT)"; }

# [2/6] Co-Authored-By em arquivos staged (auto-fix + re-stage)
_COAUTHOR="${COAUTHOR_RE:-[Cc]o-[Aa]uthored-[Bb]y|[Pp]aired-[Ww]ith|[Aa]ssisted-[Bb]y}"
COAUTHOR_COUNT=0
for file in $FILES; do
    if [ -f "$file" ] && grep -qiE "$_COAUTHOR" "$file" 2>/dev/null; then
        grep -viE "$_COAUTHOR" "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
        git add "$file" 2>/dev/null
        COAUTHOR_COUNT=$((COAUTHOR_COUNT + 1))
        _hook_log "pre-commit" "auto-fix co-autoria: $file" 2>/dev/null
    fi
done
[ $COAUTHOR_COUNT -gt 0 ] && { FIXES=$((FIXES + COAUTHOR_COUNT)); FIX_DETAILS="$FIX_DETAILS co-author($COAUTHOR_COUNT)"; }

# [3/6] Mencoes a IA em QUALQUER lugar do conteudo staged -- comentario,
# docstring, prosa, config, model-id (auto-substitui por "agente" + re-stage).
# Ao contrario da versao anterior (so pegava "Generated by X" em linha de
# comentario), casa a palavra em qualquer lugar do arquivo. "Cursor" fica de
# fora da lista principal (colide com cursor de banco/UI real) e ganha
# checagem propria: se o ARQUIVO INTEIRO tiver algum marcador de contexto de
# banco/UI (mesmo filtro do auditoria-repos.sh), pula substituicao de
# "cursor" no arquivo todo -- filtro por linha nao basta, pois a variavel
# `cursor` costuma ser atribuida numa linha e usada (`cursor.execute(...)`)
# em linhas seguintes sem nenhum marcador por perto.
_AI_WORD_CODE="${AI_WORD_CODE_RE:-\\b([Cc]laude|[Aa]nthropic|[Oo]pen[Aa][Ii]|[Cc]hat[Gg][Pp][Tt]|[Gg]emini|[Gg][Pp][Tt]-[34]|[Dd]eep[Ss]eek|[Aa]ider|[Ww]indsurf|[Cc]odeium|[Tt]abnine|[Oo]pus|[Ss]onnet|[Hh]aiku|[Ff]able)\\b}"
_AI_CURSOR_EXCLUDE="${AI_CURSOR_EXCLUDE_RE:-(api_key|api-key|provider|model|client|_MODEL|_API|endpoint|baseurl|base_url|\\.cursor\\(\\)|cursor\\s*=\\s*conn|cursor\\s*=\\s*db|cursor\\s*=\\s*self|getcursor|set_cursor|cursor_factory|CursorKind|cursor\\s*:|:\\s*cursor\\b|cursorPointer)}"

# [2026-07-28] Intervalos de linha (1-based, "ini-fim,ini-fim") que o commit em
# curso tocou. Vazio quando nao ha linha nova (remocao pura, binario, sem
# stage). Motivo: ate 2026-07-27 os auto-fixes varriam o ARQUIVO INTEIRO e
# reescreviam linha que ninguem tocou -- foi assim que "cursor: pointer" virou
# "agente: pointer" em 13 linhas de CSS que o commit nem citava.
_ranges_staged() {
    git diff --cached -U0 -- "$1" 2>/dev/null | awk '
        /^@@ / {
            plus = $3
            sub(/^\+/, "", plus)
            split(plus, p, ",")
            ini = p[1] + 0
            cnt = (p[2] == "" ? 1 : p[2] + 0)
            if (cnt > 0) printf "%d-%d,", ini, ini + cnt - 1
        }'
}

# Guarda de intervalo compartilhada pelos perl abaixo: so processa a linha
# corrente se ela estiver dentro de algum intervalo de OURO_RANGES.
_PERL_RANGES_BEGIN='BEGIN{@R=map{[split/-/]}split/,/,($ENV{OURO_RANGES}||q())}'
_PERL_RANGES_TEST='grep{$.>=$_->[0]&&$.<=$_->[1]}@R'

# [2026-07-30] Duas protecoes a mais, pelo mesmo motivo do intervalo de linhas:
# a substituicao nao pode reescrever o que NAO e mencao/atribuicao.
#
#   1. Token com barra (URL e caminho de filesystem). Trocar a marca dentro de
#      uma URL transforma link valido em link morto, e dentro de um caminho
#      inventa uma pasta que nao existe. Casos reais: um link de relatorio
#      quebrado duas vezes seguidas, e a pasta Conceitos/Claude virando
#      Conceitos/agente no proprio arquivo de regras do vault.
#   2. Escape por linha: `ia-artifact:manter`. Existe porque a regra que LISTA
#      os nomes proibidos precisa poder cita-los -- sem isso a Regra 3 do vault
#      virou "Zero mencoes a IA (agente, GPT, agente, Copilot, agente, agente)"
#      e deixou de significar qualquer coisa.
#   3. [2026-08-18] Identificador tecnico: token colado a hifen, ponto ou
#      underscore. Nome de pacote, id de aplicativo e model-id NAO sao mencao
#      nem atribuicao de autoria -- sao constante externa, como a URL do item 1.
#      Caso real: um doc de sprint que registrava `apt purge claude-desktop`
#      virou "agente-desktop", pacote que nao existe, deixando o registro
#      factualmente errado e o comando incopiavel. Mesmo estrago em
#      com.anthropic.Claude, claude.ai e claude-sonnet-4-5.
#   4. [2026-08-18] Code span de crase simples. Em markdown a crase marca "isto
#      e literal": comando, caminho, nome de arquivo. Reescrever ali quebra o
#      que o leitor vai copiar e colar.
#
#      O separador do item 3 exige alfanumerico dos DOIS lados. Sem isso o ponto
#      final de frase ("pedi ao Claude.") faz prosa comum parecer identificador
#      e escapar da regra -- verificado em teste antes de subir.
#
# Prosa solta segue sendo substituida: "pedi ao Claude" continua virando
# "pedi ao agente". A guarda so cobre o que tem forma de identificador.
#
# As guardas vem PRIMEIRO na alternancia: quando uma casa, devolve o texto
# original sem tocar.
_PERL_KEEP_TOKEN='(`[^`\n]*`|\S*/\S*|[A-Za-z0-9]+(?:[-._][A-Za-z0-9]+)+)'
_PERL_SKIP_LINE='!/ia-artifact:manter/'

AI_COUNT=0
for file in $FILES; do
    if [ -f "$file" ]; then
        _AI_RANGES=$(_ranges_staged "$file")
        [ -z "$_AI_RANGES" ] && continue
        BEFORE_SUM=$(md5sum "$file" 2>/dev/null | cut -d' ' -f1)
        OURO_RANGES="$_AI_RANGES" OURO_RE="$_AI_WORD_CODE" perl -CSD -i -pe \
            "$_PERL_RANGES_BEGIN"' if(('"$_PERL_RANGES_TEST"') && '"$_PERL_SKIP_LINE"'){ s{'"$_PERL_KEEP_TOKEN"'|$ENV{OURO_RE}}{ defined $1 ? $1 : q(agente) }gei }' \
            "$file" 2>/dev/null
        if ! grep -qiP "$_AI_CURSOR_EXCLUDE" "$file" 2>/dev/null; then
            OURO_RANGES="$_AI_RANGES" perl -CSD -i -pe \
                "$_PERL_RANGES_BEGIN"' if(('"$_PERL_RANGES_TEST"') && '"$_PERL_SKIP_LINE"'){ s{'"$_PERL_KEEP_TOKEN"'|\b[Cc]ursor\b}{ defined $1 ? $1 : q(agente) }ge }' \
                "$file" 2>/dev/null
        fi
        OURO_RANGES="$_AI_RANGES" perl -CSD -i -pe \
            "$_PERL_RANGES_BEGIN"' if('"$_PERL_RANGES_TEST"'){ s/\bagente([\s-]+agente\b)+/agente/gi }' \
            "$file" 2>/dev/null
        AFTER_SUM=$(md5sum "$file" 2>/dev/null | cut -d' ' -f1)
        if [ "$BEFORE_SUM" != "$AFTER_SUM" ]; then
            git add "$file" 2>/dev/null
            AI_COUNT=$((AI_COUNT + 1))
            _hook_log "pre-commit" "auto-fix mencao IA (substituicao): $file" 2>/dev/null
        fi
    fi
done
[ $AI_COUNT -gt 0 ] && { FIXES=$((FIXES + AI_COUNT)); FIX_DETAILS="$FIX_DETAILS ia-artifact($AI_COUNT)"; }

# [3.5/6] Anti-blacklist filenames: bloqueia ADICAO ao tracking de
# arquivos de instrucao para IA (CLAUDE.md, HANDOFF, .cursorrules, etc).
# Lista canonica em ~/.config/git/anonymity-blacklist.txt.
BLACKLIST="$HOME/.config/git/anonymity-blacklist.txt"
if [ -f "$BLACKLIST" ]; then
    ADDED=$(git diff --cached --name-only --diff-filter=A 2>/dev/null)
    if [ -n "$ADDED" ]; then
        BLOCKED_FILES=""
        while IFS= read -r pattern; do
            [ -z "$pattern" ] && continue
            [[ "$pattern" =~ ^# ]] && continue
            clean="${pattern%/}"
            for f in $ADDED; do
                case "$f" in
                    $clean|$clean/*) BLOCKED_FILES="$BLOCKED_FILES $f" ;;
                esac
            done
        done < "$BLACKLIST"
        if [ -n "$BLOCKED_FILES" ]; then
            echo "  [BLOQUEIO] Arquivos da blacklist anonimato no diff:"
            for f in $BLOCKED_FILES; do echo "    $f"; done
            echo ""
            echo "    Estes arquivos sao instrucao para IA e nao devem"
            echo "    ser versionados (Regra -1, anonimato absoluto)."
            echo ""
            echo "    Para remover do staging mantendo no filesystem:"
            echo "      git rm --cached$BLOCKED_FILES"
            echo "      printf '%s\n'$BLOCKED_FILES >> .gitignore"
            _hook_log "pre-commit" "BLOQUEADO: blacklist filename ($BLOCKED_FILES)" 2>/dev/null
            exit 1
        fi
    fi
fi

# === VERIFICACOES ADICIONAIS (puladas se framework pre-commit existe) ===

if [[ "$HAS_FRAMEWORK" == false ]]; then

    # [4/6] Whitespace: trailing spaces + newline final (auto-fix + re-stage)
    WS_COUNT=0
    for file in $FILES; do
        if [ -f "$file" ]; then
            CHANGED=0
            if grep -qP '[\t ]+$' "$file" 2>/dev/null; then
                sed -i 's/[[:space:]]*$//' "$file"
                CHANGED=1
            fi
            if [ -n "$(tail -c 1 "$file" 2>/dev/null)" ]; then
                echo "" >> "$file"
                CHANGED=1
            fi
            if [ $CHANGED -eq 1 ]; then
                git add "$file" 2>/dev/null
                WS_COUNT=$((WS_COUNT + 1))
            fi
        fi
    done
    [ $WS_COUNT -gt 0 ] && { FIXES=$((FIXES + WS_COUNT)); FIX_DETAILS="$FIX_DETAILS whitespace($WS_COUNT)"; }

    # [5/6] Secrets (BLOQUEIA - nao tem auto-fix seguro)
    _SECRET="${SECRET_RE:-sk-[a-zA-Z0-9]{20,}}"
    for file in $FILES; do
        case "$file" in
            .env|.env.*|*.key|*.pem|*.cert|*.crt) continue ;;
        esac
        if [ -f "$file" ] && grep -qP "$_SECRET" "$file" 2>/dev/null; then
            echo "  [BLOQUEIO] Secret detectado: $file"
            BLOCKS=$((BLOCKS + 1))
        fi
    done

    # [6/6] Python: syntax check (BLOQUEIA)
    for file in $FILES; do
        case "$file" in
            *.py)
                if [ -f "$file" ] && ! python3 -m py_compile "$file" 2>/dev/null; then
                    echo "  [BLOQUEIO] Sintaxe invalida: $file"
                    BLOCKS=$((BLOCKS + 1))
                fi
                ;;
        esac
    done

fi

