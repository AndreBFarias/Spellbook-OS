#!/usr/bin/env bash
# Vigia de exports do OnlyOffice: lava in-place PDFs recém-criados com o dialeto
# problemático. Gates (TODOS auditados em 2026-07-02):
#   PULA se: assinado digitalmente (pdfsig) | Producer cairo (JÁ LAVADO — o cairo
#   também emite Identity-H, sem este gate haveria loop infinito) | sem Identity-H
#   LAVA se: Producer/Creator ONLYOFFICE, OU conteúdo "RELATÓRIO DE SERVIÇO" na
#   pág. 1 (fallback p/ fluxo MEC), com BACKUP prévio em ~/.cache/pdf_lavar_backups
# Throttle no script (flock + intervalo mínimo) — TriggerLimit* não existe no systemd 249.
set -uo pipefail
LOCK="/tmp/pdf_lavar_watch.lock"
exec 9>"$LOCK"; flock -n 9 || exit 0            # já tem um rodando
MARCA="$HOME/.cache/pdf_lavar_watch.ultima"
agora=$(date +%s)
ultima=$(cat "$MARCA" 2>/dev/null || echo 0)
(( agora - ultima < 5 )) && exit 0              # debounce 5s
echo "$agora" > "$MARCA"
BKP="$HOME/.cache/pdf_lavar_backups"; mkdir -p "$BKP"
PASTAS=("$HOME/Desktop" "$HOME/Downloads" "$HOME/Controle de Bordo/Trabalho/Andre/G4F/Relatorios/Mensais")
for pasta in "${PASTAS[@]}"; do
    [ -d "$pasta" ] || continue
    while IFS= read -r -d '' pdf; do
        t1=$(stat -c '%Y %s' "$pdf" 2>/dev/null) || continue
        mt=${t1%% *}
        if (( $(date +%s) - mt < 5 )); then sleep 5; fi
        t2=$(stat -c '%Y %s' "$pdf" 2>/dev/null) || continue
        [ "$t1" != "$t2" ] && continue                                   # ainda mudando
        pdfsig "$pdf" 2>/dev/null | grep -q "^Signature #" && continue   # ASSINADO: intocável
        meta=$(pdfinfo "$pdf" 2>/dev/null | grep -iE "^(Creator|Producer)")
        echo "$meta" | grep -qi "cairo" && continue                      # já lavado (anti-loop)
        pdffonts "$pdf" 2>/dev/null | grep -q "Identity-H" || continue
        if ! echo "$meta" | grep -qi "ONLYOFFICE"; then
            pdftotext -f 1 -l 1 "$pdf" - 2>/dev/null | grep -qi "RELATÓRIO DE SERVIÇO" || continue
        fi
        cp -a "$pdf" "$BKP/$(date +%Y%m%d_%H%M%S)_$(basename "$pdf")" 2>/dev/null
        ls -t "$BKP" | tail -n +21 | while read -r velho; do rm -f "$BKP/$velho"; done
        if PDF_LAVAR_SEM_BACKUP=1 "$HOME/.local/bin/pdf_lavar" "$pdf" >/dev/null 2>&1; then
            notify-send -i document-send "PDF lavado" "$(basename "$pdf") pronto p/ sites (original em ~/.cache/pdf_lavar_backups)" 2>/dev/null || true
            echo "$(date -Is) lavado: $pdf"
        fi
    done < <(find "$pasta" -maxdepth 1 -name "*.pdf" -mmin -10 -print0 2>/dev/null)
done
exit 0
